{
  // CRA Clock website (static) + /kev.json mirror. The product itself is the GitHub Action in this repo.
  "name": "cra-clock-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // "routes": [{ "pattern": "craclock.gautamkhosla.com", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/kev.json"] }
}
